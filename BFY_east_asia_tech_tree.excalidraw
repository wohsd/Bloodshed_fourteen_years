      "opacity": 100,
      "text": "关键属性与结构调整（原版 → 新版）",
      "fontSize": 20,
      "fontFamily": 2,
      "groupIds": [],
      "locked": false,
      "fillStyle": "solid",
      "boundElements": null,
      "createdAt": "2026-10-01T04:34:34.281Z",
      "updatedAt": "2026-10-01T04:34:34.281Z",
      "version": 1,
