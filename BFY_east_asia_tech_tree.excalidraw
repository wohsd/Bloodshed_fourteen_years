    {
      "id": "title",
      "type": "text",
      "x": 80,
      "y": 48,
      "width": 1500,
      "height": 35,
      "backgroundColor": "transparent",
      "strokeColor": "#0A0A0A",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "text": "东亚战场科技树重设计（1930–1950）· 设计蓝图",
      "fontSize": 28,
      "fontFamily": 2,
      "groupIds": [],
      "locked": false,
      "fillStyle": "solid",
      "boundElements": null,
      "createdAt": "2026-10-01T04:34:34.278Z",
      "updatedAt": "2026-10-01T04:34:34.278Z",
      "version": 1,
      "textAlign": "left"
    },
    {
      "id": "subtitle",
      "type": "text",
      "x": 80,
      "y": 94,
      "width": 2700,
      "height": 20,
      "backgroundColor": "transparent",
      "strokeColor": "#404040",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "text": "原版科技树以欧洲战场为基准；本蓝图按东亚工业水平与作战形态重排年表、拆分支援装备、调整兵种与部件属性。纵向为年代，横向为科技线，箭头表示前置关系。",
      "fontSize": 16,
      "fontFamily": 2,
      "groupIds": [],
      "locked": false,
      "fillStyle": "solid",
      "boundElements": null,
      "createdAt": "2026-10-01T04:34:34.278Z",
      "updatedAt": "2026-10-01T04:34:34.278Z",
      "version": 1,
      "textAlign": "left"
    },
