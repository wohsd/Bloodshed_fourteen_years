guiTypes = {

	# 覆盖原版 browser.gui：无边框全屏浏览器窗口（用于序章视频播放）
	# web_link 硬编码打开 browser_window 并加载内部 name="browser" 的元素，名字不可改
	containerWindowType = {
		name = "browser_window"
		position = { x = 0 y = 0 }
		size = { width = 1920 height = 1080 }
		moveable = no
		fullScreen = yes
		Orientation = UPPER_LEFT

		browserType = {
			name = "browser"
			spriteType = "GFX_dummy_browser"
			position = { x = 0 y = 0 }
			size = { width = 1920 height = 1080 }
		}

		# 关闭按钮：右上角小叉 + ESC（按钮必须保留合法贴图，否则引擎闪退）
		buttonType = {
			name = "close"
			quadTextureSprite = "GFX_closebutton"
			position = { x = -20 y = 16 }
			Orientation = UPPER_RIGHT
			clicksound = click_close
			shortcut = "ESCAPE"
		}
	}

}
