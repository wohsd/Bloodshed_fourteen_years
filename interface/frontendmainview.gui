	# BFY补充：新版引擎DLC界面需要这两个容器模板，原版frontendmainview.gui中有定义，
	# mod定制本文件时缺失，报“Undefined GUI_TYPE: owned_dlc_item”（有崩溃风险）
	containerWindowType = {
		name = "owned_dlc_item"
		size = { width = 50 height = 50 }

		buttonType =
		{
			position = { x = -230 y = 0 }
			name ="dlc_button"
			spriteType = "GFX_frontend_banner_dlc018"
		}

		iconType = {
			name = "glowup"
			position = { x = -50 y = -21 }
			spriteType = "GFX_spirit_glow"
			scale = 0.8
		}

		buttonType = {
			name = "owned_tick"
			spriteType = "GFX_BPT_area_defense_setting_tick"
			position = { x = -6 y = 1 }
			Orientation = center_left
			scale = 0.56
			alwaysTransparent = yes
		}

		buttonType = {
			name = "enabled_tick"
			spriteType = "GFX_general_check"
			position = { x = 28 y = 24 }
			Orientation = center_left
			alwaysTransparent = yes
		}
	}


	
